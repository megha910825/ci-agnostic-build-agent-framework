# Auto-generated by Ansible — do not edit manually
# CI System: {{ ci_system }}
# Generated: {{ ansible_date_time.iso8601 }}

{% if ci_system == 'github-actions' %}
url={{ github_actions_url }}
token={{ agent_token }}
name={{ inventory_hostname }}-{{ ci_system }}-agent
work={{ agent_work_dir }}/_work
{% elif ci_system == 'azure-pipelines' %}
url={{ azure_devops_url }}
auth=pat
token={{ agent_token }}
pool={{ agent_pool_name | default('Default') }}
agent={{ inventory_hostname }}-agent
work={{ agent_work_dir }}/_work
{% elif ci_system == 'teamcity' %}
serverUrl={{ teamcity_server_url }}
name={{ inventory_hostname }}-agent
workDir={{ agent_work_dir }}/work
tempDir={{ agent_work_dir }}/temp
ownPort=9090
{% endif %}
