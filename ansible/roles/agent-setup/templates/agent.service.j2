# Auto-generated by Ansible — do not edit manually
# CI System: {{ ci_system }}

[Unit]
Description=CI Build Agent ({{ ci_system }})
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User={{ agent_user }}
WorkingDirectory={{ agent_work_dir }}

{% if ci_system == 'github-actions' %}
ExecStart={{ agent_work_dir }}/run.sh
{% elif ci_system == 'azure-pipelines' %}
ExecStart={{ agent_work_dir }}/run.sh
{% elif ci_system == 'teamcity' %}
ExecStart=/bin/sh {{ agent_work_dir }}/bin/agent.sh start
{% endif %}

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=build-agent

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ agent_work_dir }}

[Install]
WantedBy=multi-user.target
